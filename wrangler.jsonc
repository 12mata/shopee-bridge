{
  "name": "shopee-bridge",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "kv_namespaces": [
    { "binding": "DB", "id": "GANTI_DENGAN_ID_KV_NAMESPACE" }
  ]
}
